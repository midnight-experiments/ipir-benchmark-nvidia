+                            0 => 0,
+                            1 => q,
+                            _ => rng.gen::<u64>() >> rng.gen_range(0..64),
+                        })
+                        .collect();
+                    assert_eq!(
+                        tau_coeffs(&p, g, q),
+                        tau_coeffs_reference(&p, g, q),
+                        "d={d} q={q} g={g}"
+                    );
+                }
+            }
+        }
+    }
